{
  "name": "ClanChallenge",
  "type": "object",
  "description": "A head-to-head team challenge. Score = sum of members' points earned during the window (current team total minus the baseline snapshot taken at start). Resolves to a winner when end_date passes.",
  "properties": {
    "challenger_clan_id": {
      "type": "string"
    },
    "challenger_clan_name": {
      "type": "string"
    },
    "opponent_clan_id": {
      "type": "string"
    },
    "opponent_clan_name": {
      "type": "string"
    },
    "metric": {
      "type": "string",
      "enum": [
        "team_points"
      ],
      "default": "team_points",
      "description": "MVP: total team points earned during the window. Enum kept for future metrics."
    },
    "duration_days": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date-time"
    },
    "end_date": {
      "type": "string",
      "format": "date-time"
    },
    "challenger_baseline": {
      "type": "number",
      "default": 0,
      "description": "Challenger team's summed total_points at start. Live score = current sum minus this."
    },
    "opponent_baseline": {
      "type": "number",
      "default": 0
    },
    "challenger_score": {
      "type": "number",
      "default": 0,
      "description": "Frozen final score, written on resolution."
    },
    "opponent_score": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    },
    "winner_clan_id": {
      "type": "string"
    }
  },
  "required": [
    "challenger_clan_id",
    "opponent_clan_id",
    "duration_days"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}