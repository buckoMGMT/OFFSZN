{
  "name": "Clan",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "high_school",
        "club",
        "college",
        "other"
      ]
    },
    "sport": {
      "type": "string"
    },
    "school_name": {
      "type": "string"
    },
    "admin_id": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "roster_cap": {
      "type": "number",
      "default": 25,
      "description": "Max athletes allowed in this clan. Default 25. Ignored when unlimited_roster is true."
    },
    "unlimited_roster": {
      "type": "boolean",
      "default": false,
      "description": "Admin override \u2014 set manually to let a clan grow past its roster_cap (e.g. large programs / school contracts)."
    },
    "description": {
      "type": "string"
    },
    "emblem_url": {
      "type": "string"
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "wins": {
      "type": "number",
      "default": 0
    },
    "losses": {
      "type": "number",
      "default": 0
    },
    "is_public": {
      "type": "boolean",
      "default": true
    },
    "join_code": {
      "type": "string"
    },
    "announcement": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type"
  ]
}