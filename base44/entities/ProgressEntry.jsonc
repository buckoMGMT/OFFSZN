{
  "name": "ProgressEntry",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "weight_lbs": {
      "type": "number"
    },
    "body_fat_pct": {
      "type": "number"
    },
    "photo_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "weekly_avg_sleep": {
      "type": "number"
    },
    "weekly_macro_adherence_pct": {
      "type": "number"
    },
    "weekly_workout_count": {
      "type": "number"
    }
  },
  "required": [
    "athlete_id",
    "date"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}