// base44/entities/User.jsonc
// Extends the built-in User entity. Do NOT redefine built-in fields
// (id, email, created_date, etc.) — this file only adds new ones.
//
// date_of_birth lives on User (not Athlete) because age must be checked
// at the authentication/account layer, before an Athlete profile even
// exists — you never want a scenario where someone can create a User
// account, get partway through onboarding, and only THEN get blocked.
{
  "type": "object",
  "properties": {
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "ISO 8601 date (YYYY-MM-DD). Required at signup. Platform minimum age is 13 — see functions/ageGate.ts, which is the actual enforcement point. This field alone does not block anyone; it's the CLI/entities layer, enforcement is in code."
    },
    "age_verified": {
      "type": "boolean",
      "default": false,
      "description": "Set true by ageGate.ts once date_of_birth passes the 13+ check. Frontend should treat age_verified=false as 'onboarding incomplete', not just hide features."
    },
    "is_minor": {
      "type": "boolean",
      "default": true,
      "description": "Set by ageGate.ts, true if age < 18. Read by minorSafetyGuard.ts to restrict coach<->minor messaging and purchases. Do not let this be set anywhere except ageGate.ts."
    }
  },
  "required": ["date_of_birth"]
}
