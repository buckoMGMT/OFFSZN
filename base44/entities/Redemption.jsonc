{
  "name": "Redemption",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "reward_item_id": {
      "type": "string",
      "description": "Optional in schema; enforced in code for merch/gift_card redemptions."
    },
    "reward_name": {
      "type": "string"
    },
    "reward_type": {
      "type": "string",
      "enum": [
        "merch",
        "gift_card"
      ]
    },
    "points_spent": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "shipping_address": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "athlete_id",
    "points_spent",
    "reward_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}