{
  "name": "Athlete",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "sport": {
      "type": "string",
      "enum": [
        "football",
        "basketball",
        "baseball",
        "soccer",
        "track",
        "volleyball",
        "wrestling",
        "swimming",
        "lacrosse",
        "tennis",
        "softball",
        "cross_country",
        "golf",
        "athlete",
        "other"
      ]
    },
    "position": {
      "type": "string"
    },
    "school": {
      "type": "string"
    },
    "grade": {
      "type": "string",
      "enum": [
        "freshman",
        "sophomore",
        "junior",
        "senior",
        "college"
      ]
    },
    "height_inches": {
      "type": "number"
    },
    "weight_lbs": {
      "type": "number"
    },
    "goal_weight_lbs": {
      "type": "number"
    },
    "goal_calories": {
      "type": "number"
    },
    "goal_protein_g": {
      "type": "number"
    },
    "goal_carbs_g": {
      "type": "number"
    },
    "goal_fats_g": {
      "type": "number"
    },
    "weekly_budget_usd": {
      "type": "number"
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free"
    },
    "role": {
      "type": "string",
      "enum": [
        "athlete",
        "coach",
        "school_admin"
      ],
      "default": "athlete"
    },
    "clan_id": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "current_streak_days": {
      "type": "number",
      "default": 0
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "bench_press_lbs": {
      "type": "number"
    },
    "squat_lbs": {
      "type": "number"
    },
    "deadlift_lbs": {
      "type": "number"
    },
    "mile_time_seconds": {
      "type": "number"
    },
    "highlight_url": {
      "type": "string"
    },
    "friends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "approved_video_count": {
      "type": "number",
      "default": 0
    },
    "total_video_views": {
      "type": "number",
      "default": 0
    },
    "is_coach_verified": {
      "type": "boolean",
      "default": false
    },
    "is_flagged": {
      "type": "boolean",
      "default": false
    },
    "flagged_reason": {
      "type": "string"
    },
    "flagged_at": {
      "type": "string",
      "format": "date-time"
    },
    "throttle_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "display_name"
  ]
}