{
  "name": "Athlete",
  "type": "object",
  "properties": {
    "display_name": {
      "type": "string"
    },
    "sport": {
      "type": "string",
      "enum": [
        "football",
        "basketball",
        "baseball",
        "soccer",
        "track",
        "volleyball",
        "wrestling",
        "boxing",
        "mma",
        "swimming",
        "lacrosse",
        "tennis",
        "softball",
        "cross_country",
        "golf",
        "athlete",
        "general_fitness",
        "other"
      ]
    },
    "position": {
      "type": "string"
    },
    "jersey_number": {
      "type": "string",
      "description": "Athlete's jersey number, shown on the recruiting card. Free text (supports '00'). Absent = no number shown."
    },
    "gpa": {
      "type": "number",
      "description": "Optional self-reported GPA (0.0-5.0, weighted scales allowed). Shown on the recruiting card \u2014 the numbers college coaches actually check."
    },
    "hometown": {
      "type": "string",
      "description": "City, ST \u2014 shown on the recruiting card so recruiters know where to find film and games."
    },
    "school": {
      "type": "string"
    },
    "grade": {
      "type": "string",
      "enum": [
        "freshman",
        "sophomore",
        "junior",
        "senior",
        "college"
      ]
    },
    "height_inches": {
      "type": "number"
    },
    "weight_lbs": {
      "type": "number"
    },
    "goal_weight_lbs": {
      "type": "number"
    },
    "goal_calories": {
      "type": "number"
    },
    "goal_protein_g": {
      "type": "number"
    },
    "goal_carbs_g": {
      "type": "number"
    },
    "goal_fats_g": {
      "type": "number"
    },
    "weekly_budget_usd": {
      "type": "number"
    },
    "training_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "starting_spot",
          "gain_muscle",
          "cut_weight",
          "make_weight",
          "get_faster",
          "recruiting",
          "stay_ready",
          "get_stronger",
          "general_health",
          "conditioning"
        ]
      },
      "default": []
    },
    "experience_level": {
      "type": "string",
      "enum": [
        "new",
        "some",
        "experienced"
      ],
      "description": "General-fitness path only: training experience self-report."
    },
    "biological_sex": {
      "type": "string",
      "enum": [
        "male",
        "female",
        "unspecified"
      ],
      "description": "Required input for the Mifflin-St Jeor BMR equation. Asked once, never displayed on profile."
    },
    "training_days_per_week": {
      "type": "number",
      "default": 4
    },
    "season_status": {
      "type": "string",
      "enum": [
        "in_season",
        "pre_season",
        "off_season"
      ],
      "default": "off_season"
    },
    "equipment_access": {
      "type": "string",
      "enum": [
        "full_gym",
        "home_gym",
        "bodyweight_only"
      ],
      "default": "full_gym"
    },
    "has_limitations": {
      "type": "boolean",
      "default": false
    },
    "limitations_note": {
      "type": "string"
    },
    "bmr_calories": {
      "type": "number",
      "description": "Computed. Stored so targets can be recomputed on weight change."
    },
    "tdee_calories": {
      "type": "number",
      "description": "Computed BMR \u00d7 activity factor."
    },
    "water_goal_oz": {
      "type": "number",
      "default": 128
    },
    "sleep_goal_hours": {
      "type": "number",
      "default": 8
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free"
    },
    "pass_subscription_id": {
      "type": "string",
      "description": "Stripe subscription id for the ALL-SZN Pass. Set by stripeWebhook on purchase, cleared on cancellation."
    },
    "role": {
      "type": "string",
      "enum": [
        "athlete",
        "coach",
        "school_admin"
      ],
      "default": "athlete"
    },
    "clan_id": {
      "type": "string"
    },
    "avatar_url": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "current_streak_days": {
      "type": "number",
      "default": 0
    },
    "total_points": {
      "type": "number",
      "default": 0
    },
    "onboarding_complete": {
      "type": "boolean",
      "default": false
    },
    "bench_press_lbs": {
      "type": "number"
    },
    "squat_lbs": {
      "type": "number"
    },
    "deadlift_lbs": {
      "type": "number"
    },
    "mile_time_seconds": {
      "type": "number"
    },
    "forty_yd_seconds": {
      "type": "number",
      "description": "40-yard dash time in seconds (e.g. 4.55). Optional recruiting metric."
    },
    "vertical_jump_inches": {
      "type": "number",
      "description": "Standing vertical jump in inches. Optional recruiting metric."
    },
    "highlight_url": {
      "type": "string"
    },
    "friends": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "approved_video_count": {
      "type": "number",
      "default": 0
    },
    "total_video_views": {
      "type": "number",
      "default": 0
    },
    "is_coach_verified": {
      "type": "boolean",
      "default": false
    },
    "is_flagged": {
      "type": "boolean",
      "default": false
    },
    "flagged_reason": {
      "type": "string"
    },
    "flagged_at": {
      "type": "string",
      "format": "date-time"
    },
    "throttle_until": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_account_id": {
      "type": "string",
      "description": "Stripe Connect Express account id for coach payouts"
    },
    "stripe_onboarding_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "complete"
      ],
      "default": "none"
    },
    "coach_sub_price_usd": {
      "type": "number",
      "description": "Monthly price the coach charges for their 1-on-1 coaching service subscription"
    },
    "coach_trial_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Coach offers a one-time 7-day pass to their coaching service (same access as a subscription, time-boxed)."
    },
    "coach_trial_price_usd": {
      "type": "number",
      "description": "One-time price of the 7-day coaching pass. Suggested ~30% of monthly."
    },
    "identity_status": {
      "type": "string",
      "enum": [
        "unverified",
        "pending",
        "verified",
        "failed"
      ],
      "default": "unverified",
      "description": "Stripe Identity (government ID + selfie) verification status for coaches"
    },
    "identity_verification_session_id": {
      "type": "string",
      "description": "Stripe Identity verification session id"
    },
    "coach_services": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "messaging",
          "form_checks",
          "weekly_programming",
          "progress_checkins"
        ]
      },
      "default": [
        "messaging"
      ],
      "description": "Services included in this coach's subscription. Messaging is always on; the rest are optional but encouraged."
    },
    "coach_response_sla_hours": {
      "type": "number",
      "default": 48,
      "description": "Coach's committed reply time for subscriber messages."
    },
    "coach_bio": {
      "type": "string",
      "description": "Their storefront. 300 char cap."
    },
    "coach_specialties": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "coach_years_experience": {
      "type": "number"
    },
    "coach_levels_coached": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "youth",
          "middle_school",
          "high_school",
          "college",
          "semi_pro",
          "pro",
          "private"
        ]
      },
      "default": []
    },
    "coach_certifications": {
      "type": "string"
    },
    "coach_profile_complete": {
      "type": "boolean",
      "default": false
    },
    "minor_conduct_agreed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "display_name"
  ]
}