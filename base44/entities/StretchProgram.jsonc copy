// base44/entities/StretchProgram.jsonc
// Apply the SAME price_cents/coach_id/visibility block to UserVideoSubmission.jsonc —
// kept as two files since they're separate entities in your current schema.
{
  "name": "StretchProgram",
  "type": "object",
  "title": "Stretch Program",
  "description": "Sport-specific fascia/mobility training content. Free by default, priced when coach_id is set.",
  "properties": {
    "title": { "type": "string" },
    "coach_id": { "type": "string", "description": "FK -> Athlete.id where role == 'coach'" },
    "price_cents": { "type": "integer", "default": 0, "minimum": 0, "maximum": 50000 },
    "currency": { "type": "string", "default": "usd" },
    "visibility": { "type": "string", "enum": ["public", "premium_only", "school_licensed"], "default": "public" },
    "stripe_price_id": { "type": "string" },
    "status": { "type": "string", "enum": ["draft", "published", "archived"], "default": "draft" }
  },
  "required": ["title"]
}
