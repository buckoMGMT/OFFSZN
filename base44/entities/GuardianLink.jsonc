{
  "name": "GuardianLink",
  "type": "object",
  "title": "Guardian Link",
  "description": "Parent/guardian verification record for a minor athlete's account. Created by the minor via guardianConsent 'invite' (share-link mechanism); verified only by a logged-in ADULT whose account email matches guardian_email. Pending links grant NOTHING \u2014 every guard checks status === 'verified'.",
  "properties": {
    "minor_user_id": {
      "type": "string"
    },
    "guardian_email": {
      "type": "string"
    },
    "guardian_name": {
      "type": "string",
      "description": "Guardian's display name \u2014 shown to the minor in the chat visibility banner. Falls back to guardian_email when absent."
    },
    "guardian_user_id": {
      "type": "string",
      "description": "Set once the guardian creates/links their own account"
    },
    "invite_code": {
      "type": "string",
      "description": "Random one-time code embedded in the shareable invite link. Consumed at verification."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "verified",
        "revoked"
      ],
      "default": "pending"
    },
    "verification_method": {
      "type": "string",
      "enum": [
        "email_confirmation",
        "payment_method_check"
      ],
      "default": "email_confirmation"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "public_exposure_approved": {
      "type": "boolean",
      "default": false,
      "description": "Guardian opt-in for the minor to appear on public surfaces (leaderboards, discoverable recruiting). Checked server-side by the leaderboard function. Default false \u2014 minors are hidden from public boards until a verified guardian approves."
    }
  },
  "required": [
    "minor_user_id",
    "guardian_email"
  ],
  "rls": {
    "read": true,
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}