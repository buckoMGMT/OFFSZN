{
  "name": "CoachSubscription",
  "type": "object",
  "description": "An athlete following/subscribing to a coach's account for content updates. Paid subscriptions unlock messaging and exclusive service features.",
  "properties": {
    "subscriber_athlete_id": {
      "type": "string"
    },
    "coach_athlete_id": {
      "type": "string"
    },
    "notify_new_content": {
      "type": "boolean",
      "default": true
    },
    "is_paid": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "canceled"
      ],
      "default": "active"
    },
    "stripe_subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "subscriber_athlete_id",
    "coach_athlete_id"
  ]
}