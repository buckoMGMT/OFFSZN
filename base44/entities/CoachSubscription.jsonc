{
  "name": "CoachSubscription",
  "type": "object",
  "description": "An athlete following/subscribing to a coach's account for content updates. Paid subscriptions unlock messaging and exclusive service features.",
  "properties": {
    "subscriber_athlete_id": {
      "type": "string"
    },
    "coach_athlete_id": {
      "type": "string"
    },
    "notify_new_content": {
      "type": "boolean",
      "default": true
    },
    "is_paid": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "past_due",
        "canceled"
      ],
      "default": "active"
    },
    "plan": {
      "type": "string",
      "enum": [
        "monthly",
        "trial"
      ],
      "default": "monthly",
      "description": "trial = one-time 7-day coaching pass. Same access as monthly, auto-expires at trial_ends_at (lapsed server-side by dmGuard)."
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set by stripeWebhook when a 7-day pass is purchased."
    },
    "stripe_subscription_id": {
      "type": "string"
    }
  },
  "required": [
    "subscriber_athlete_id",
    "coach_athlete_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}