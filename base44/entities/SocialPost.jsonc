{
  "name": "SocialPost",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "athlete_name": {
      "type": "string"
    },
    "athlete_avatar": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "achievement",
        "macro_log",
        "workout_complete",
        "streak",
        "clan_challenge",
        "weight_milestone"
      ]
    },
    "content": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "liked_by": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "author_id": {
            "type": "string"
          },
          "author_name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        }
      }
    },
    "clan_id": {
      "type": "string"
    },
    "metric_value": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "pending_human_review"
      ],
      "default": "approved"
    },
    "moderation_notes": {
      "type": "string"
    }
  },
  "required": [
    "athlete_id",
    "type",
    "content"
  ]
}