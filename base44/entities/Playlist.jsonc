{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "athlete_id": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "Playlist icon key (dumbbell, zap, flame, timer, run, trophy, bike, heart). Rendered via the shared lucide icon map."
    },
    "program_ids": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "athlete_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}