{
  "name": "UserVideoSubmission",
  "type": "object",
  "properties": {
    "athlete_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "caption": {
      "type": "string",
      "description": "Coach-authored, 500 char cap"
    },
    "video_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "Custom thumbnail image for the video. Runs through moderation before public."
    },
    "sport": {
      "type": "string",
      "enum": [
        "football",
        "basketball",
        "baseball",
        "soccer",
        "track",
        "volleyball",
        "wrestling",
        "boxing",
        "mma",
        "swimming",
        "lacrosse",
        "tennis",
        "softball",
        "cross_country",
        "general_fitness",
        "other"
      ]
    },
    "position": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "workout",
        "tutorial",
        "form_check",
        "progress",
        "challenge"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "default": "intermediate"
    },
    "equipment_needed": {
      "type": "string",
      "enum": [
        "full_gym",
        "home_gym",
        "bodyweight_only"
      ],
      "default": "full_gym"
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "muscle_groups": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "duration_minutes": {
      "type": "number"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "moderation_notes": {
      "type": "string"
    },
    "likes": {
      "type": "number",
      "default": 0
    },
    "views": {
      "type": "number",
      "default": 0
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "save_count": {
      "type": "number",
      "default": 0
    },
    "completion_count": {
      "type": "number",
      "default": 0
    },
    "price_usd": {
      "type": "number",
      "description": "Coach-set one-time price. Absent or 0 = free to watch."
    }
  },
  "required": [
    "athlete_id",
    "title",
    "video_url"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.status": "approved"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}