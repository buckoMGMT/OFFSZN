// base44/entities/Athlete.jsonc
{
  "name": "Athlete",
  "type": "object",
  "title": "Athlete",
  "description": "Athlete profile linked 1:1 to a Base44 User. Holds stats, role, and trust/safety state.",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "FK -> User.id. Every Athlete must belong to an age-verified User."
    },
    "role": {
      "type": "string",
      "enum": ["athlete", "coach", "school_admin", "platform_admin"],
      "default": "athlete"
    },
    "is_flagged": {
      "type": "boolean",
      "default": false,
      "description": "Set by the Fraud & Security Guard agent. Never set true manually except by a human reviewing a FraudEvent."
    },
    "flagged_reason": { "type": "string" },
    "flagged_at": { "type": "string", "format": "date-time" },
    "throttle_until": {
      "type": "string",
      "format": "date-time",
      "description": "backend_functions that touch points/redemptions must reject calls while now() < throttle_until"
    },
    "coach_stripe_account_id": { "type": "string" },
    "coach_payout_status": {
      "type": "string",
      "enum": ["not_onboarded", "pending", "active", "restricted"],
      "default": "not_onboarded"
    },
    "identity_verified": {
      "type": "boolean",
      "default": false,
      "description": "Coach-only. Set true after ID verification (e.g. Stripe Identity). Required by minorSafetyGuard.ts before a coach's content can reach a minor athlete — payout-active alone is not sufficient once 13-17 year-olds are on the platform."
    },
    "points_balance": { "type": "integer", "default": 0 },
    "sport": { "type": "string" },
    "position": { "type": "string" },
    "clan_id": { "type": "string" }
  },
  "required": ["user_id", "role"]
}
