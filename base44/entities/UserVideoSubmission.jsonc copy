// base44/entities/UserVideoSubmission.jsonc
{
  "name": "UserVideoSubmission",
  "type": "object",
  "title": "User Video Submission",
  "description": "Athlete or coach-uploaded video. status is written ONLY by the Moderator agent or a human reviewer, never by the uploading user.",
  "properties": {
    "athlete_id": { "type": "string" },
    "coach_id": { "type": "string" },
    "video_url": { "type": "string" },
    "price_cents": { "type": "integer", "default": 0, "minimum": 0, "maximum": 50000 },
    "currency": { "type": "string", "default": "usd" },
    "status": {
      "type": "string",
      "enum": ["pending_review", "approved", "rejected", "pending_human_review"],
      "default": "pending_review"
    },
    "moderation_notes": { "type": "string" }
  },
  "required": ["athlete_id", "video_url"]
}
