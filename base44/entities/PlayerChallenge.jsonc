{
  "name": "PlayerChallenge",
  "type": "object",
  "description": "1v1 athlete challenge. Offer \u2192 accept flow: created as 'pending' (24h expiry), baselines + window are snapshotted ONLY at accept. Score = points earned during the window (current total_points minus the baseline snapshot). All writes happen server-side via the pvpChallenge function \u2014 client writes are blocked by RLS.",
  "properties": {
    "challenger_athlete_id": {
      "type": "string"
    },
    "challenger_name": {
      "type": "string"
    },
    "opponent_athlete_id": {
      "type": "string"
    },
    "opponent_name": {
      "type": "string"
    },
    "metric": {
      "type": "string",
      "enum": [
        "points"
      ],
      "default": "points"
    },
    "duration_days": {
      "type": "number"
    },
    "start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Set at ACCEPT, not at creation."
    },
    "end_date": {
      "type": "string",
      "format": "date-time",
      "description": "Set at ACCEPT: start + duration_days."
    },
    "challenger_baseline": {
      "type": "number",
      "default": 0
    },
    "opponent_baseline": {
      "type": "number",
      "default": 0
    },
    "challenger_score": {
      "type": "number",
      "default": 0,
      "description": "Frozen final score, written on resolution."
    },
    "opponent_score": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "declined",
        "expired",
        "completed"
      ],
      "default": "pending"
    },
    "winner_athlete_id": {
      "type": "string"
    }
  },
  "required": [
    "challenger_athlete_id",
    "opponent_athlete_id",
    "duration_days"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}