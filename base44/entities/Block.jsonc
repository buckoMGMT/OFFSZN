{
  "name": "Block",
  "type": "object",
  "properties": {
    "blocker_athlete_id": {
      "type": "string",
      "description": "Athlete who initiated the block"
    },
    "blocked_athlete_id": {
      "type": "string",
      "description": "Athlete being blocked"
    }
  },
  "required": [
    "blocker_athlete_id",
    "blocked_athlete_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}
